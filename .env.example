# Optional: let an OpenAI-compatible model propose the cleaning steps.
# All three must be set; otherwise the offline brain is used (full function).
SCRUBPILOT_LLM_BASE_URL=https://api.openai.com/v1
SCRUBPILOT_LLM_API_KEY=
SCRUBPILOT_LLM_MODEL=gpt-4o-mini

# Web app port (Render sets this automatically).
PORT=7860
